# Copy to .env (git-ignored) and fill in. Values below are placeholders.
# Analyst agent: Gemini directly (default) or the same model through OpenRouter.
LLM_PROVIDER=google
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_PROXY=http://127.0.0.1:40000          # only Gemini calls go through it (e.g. Cloudflare WARP proxy mode) where Google refuses the server's region
# OPENROUTER_API_KEY=your-openrouter-key        # only with LLM_PROVIDER=openrouter
# AGENT_OPENROUTER_MODEL=google/gemini-3.5-flash

# Owner/admin connection, used only by `python -m app.publish`
DATABASE_URL=postgresql+psycopg://s2cd:change-me@localhost:5432/s2cd
# Password publish.py sets on the read-only role s2cd_reader
READER_PASSWORD=change-me-too
# What the API and the agent use: the read-only role
READER_DATABASE_URL=postgresql+psycopg://s2cd_reader:change-me-too@localhost:5432/s2cd

# Limits (all per client IP unless noted)
AGENT_DAILY_CAP=300          # chat calls per day, whole service
AGENT_RATE=6/minute          # chat
DB_RATE=30/minute            # database explorer queries

# Access code for the costly features (analyst chat, SQL console, NEW date comparisons).
# Leave ACCESS_CODE_HASH unset to run everything open (local dev). Make both values with:
#   uv run python -m app.auth hash      # asks for the code, prints the ACCESS_CODE_HASH line (keep the single quotes)
#   uv run python -m app.auth secret    # prints a SESSION_SECRET line
ACCESS_CODE_HASH='pbkdf2_sha256$600000$<salt_b64>$<hash_b64>'
SESSION_SECRET=replace-with-48-random-characters
LOGIN_RATE=5/minute          # access-code attempts per client IP
