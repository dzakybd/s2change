;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#1f2937;" value="east pass" vertex="1"><mxGeometry height="24" width="100" x="187" y="398" as="geometry"/></mxCell><mxCell id="A_note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=2;fontColor=#475569;" value="Where passes meet, brightness jumps. That is not change." vertex="1"><mxGeometry height="54" width="280" x="20" y="428" as="geometry"/></mxCell><mxCell id="T_head" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#b91c1c;" value="Provided example: one threshold for the whole image" vertex="1"><mxGeometry height="30" width="840" x="345" y="18" as="geometry"/></mxCell><mxCell id="B_op" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#1f2937;spacing=10;" value="Euclidean distance across the 3 bands,&lt;br&gt;then one Otsu threshold on the images as delivered" vertex="1"><mxGeometry height="76" width="630" x="345" y="82" as="geometry"/></mxCell><mxCell id="B_cap" parent="1" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#b91c1c;" value="&lt;b style=&quot;font-size:20px&quot;&gt;111.4 km²&lt;/b&gt;&lt;br&gt;flagged, mostly seams" vertex="1"><mxGeometry height="52" width="200" x="1003" y="196" as="geometry"/></mxCell><mxCell id="Bot_head" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#0f766e;" value="This work: correct the seams, then calibrate the noise" vertex="1"><mxGeometry height="30" width="840" x="345" y="258" as="geometry"/></mxCell><mxCell id="S1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1f2937;spacing=6;" value="&lt;b&gt;1&lt;/b&gt; Split into 3 zones, one scene pair each" vertex="1"><mxGeometry height="104" width="150" x="345" y="302" as="geometry"/></mxCell><mxCell id="S2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1f2937;spacing=6;" value="&lt;b&gt;2&lt;/b&gt; Normalise each zone on stable ground" vertex="1"><mxGeometry height="104" width="150" x="515" y="302" as="geometry"/></mxCell><mxCell id="S3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1f2937;spacing=6;" value="&lt;b&gt;3&lt;/b&gt; Score change against the noise of its zone and brightness" vertex="1"><mxGeometry height="104" width="150" x="685" y="302" as="geometry"/></mxCell><mxCell id="S4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1f2937;spacing=6;" value="&lt;b&gt;4&lt;/b&gt; Keep what noise passes ≤ 1 in 1,000, then clean" vertex="1"><mxGeometry height="104" width="150" x="855" y="302" as="geometry"/></mxCell><mxCell id="Z_cap" parent="1" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#475569;" value="3 zones, 90 m buffer" vertex="1"><mxGeometry height="26" width="160" x="340" y="586" as="geometry"/></mxCell><mxCell id="Note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#334155;spacing=8;" value="Thresholds come from stable ground, not a textbook table. The false-alarm rate measured on held-out stable pixels is &lt;b style=&quot;white-space:nowrap&quot;&gt;0.09–0.11&amp;nbsp;%&lt;/b&gt;, at the 0.1&amp;nbsp;% target." vertex="1"><mxGeometry height="96" width="470" x="535" y="462" as="geometry"/></mxCell><mxCell id="O_cap" parent="1" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f766e;" value="&lt;b style=&quot;font-size:20px&quot;&gt;4.17 km²&lt;/b&gt;&lt;br&gt;223 polygons,&lt;br&gt;81&amp;nbsp;% in mine facilities" vertex="1"><mxGeometry height="66" width="175" x="1015" y="458" as="geometry"/></mxCell><object label="" scientificIllustratorRasterReason="Real Sentinel-2 map field: per-pixel source pass of the before date over the AOI" scientificIllustratorSourceTightlyCropped="true" scientificIllustratorAtomicRasterUnit="true" scientificIllustratorContainsReconstructableContent="false" scientificIllustratorDecompositionNote="Single map field with no text; legend, caption and labels are separate editable cells" scientificIllustratorSourcePath="/Users/dzaky.fawwaz/Documents/projects/solafune/change_detection/docs/figures/overview_assets/before_sources.png" scientificIllustratorCropLeftPercent="0" scientificIllustratorCropTopPercent="0" scientificIllustratorCropRightPercent="0" scientificIllustratorCropBottomPercent="0" id="A_img1"><mxCell parent="1" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1"><mxGeometry height="129" width="135" x="20" y="208" as="geometry"/></mxCell></object><object label="" scientificIllustratorRasterReason="Real Sentinel-2 map field: per-pixel source pass of the after date over the AOI" scientificIllustratorSourceTightlyCropped="true" scientificIllustratorAtomicRasterUnit="true" scientificIllustratorContainsReconstructableContent="false" scientificIllustratorDecompositionNote="Single map field with no text; legend, caption and labels are separate editable cells" scientificIllustratorSourcePath="/Users/dzaky.fawwaz/Documents/projects/solafune/change_detection/docs/figures/overview_assets/after_sources.png" scientificIllustratorCropLeftPercent="0" scienti